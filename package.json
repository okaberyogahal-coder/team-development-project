{
  "name": "mirai-life",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "auth:setup": "node scripts/auth-setup.mjs",
    "build:unity": "node scripts/build-unity.mjs",
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "test:plaza": "tsx --test tests/plaza/*.test.ts",
    "test": "npm run test:plaza && npm run test:ai-navi && npm run test:local-demo",
    "dev:plaza": "tsx server/plaza/index.ts",
    "load:plaza": "tsx scripts/plaza-load.ts",
    "test:browser": "playwright test",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:unity": "playwright test --config playwright.unity.config.ts",
    "test:unity:auth": "playwright test --config playwright.unity-auth.config.ts",
    "dev:lan": "node scripts/dev-lan.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:check": "tsx scripts/db-check.ts",
    "test:db": "prisma generate && tsx scripts/test-database.ts",
    "test:ai-navi": "node --import tsx --test tests/ai-navi/*.test.ts",
    "dev:ai-navi": "node scripts/dev-ai-navi.mjs",
    "test:local-demo": "node --import tsx --test tests/local-demo/*.test.ts"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.11",
    "livekit-client": "^2.15.6",
    "livekit-server-sdk": "^2.19.1",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.4.47",
    "prisma": "7.10.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
