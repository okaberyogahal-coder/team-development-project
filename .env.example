# Next.js is started on port 3002; plaza server on 3003.
# Empty: use the hostname of the page (works for both localhost and LAN).
NEXT_PUBLIC_PLAZA_WS_URL=
PLAZA_PORT=3003
# Empty in local development: permit localhost and this PC's detected LAN addresses.
# Set exact HTTPS origins for deployed environments.
PLAZA_ALLOWED_ORIGINS=
# LiveKit Cloud only: no call connection is attempted while unset.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Use a unique prefix for this application's rooms.
LIVEKIT_ROOM_PREFIX=milife-plaza

# Local PostgreSQL: npm run db:up (compose.yaml; local credentials only).
# Server-only. Production URLs must never use NEXT_PUBLIC_ prefixes.
DATABASE_URL=postgresql://melife:local-development-only@localhost:5434/melife
# Migration/administrative URL. For hosted databases use a direct or session-mode
# connection, not the transaction pooler. If empty, DATABASE_URL is used.
DIRECT_URL=
# Optional integration tests: isolated local database, never the development/production DB.
DATABASE_TEST_URL=postgresql://melife:local-test-only@localhost:5435/melife_test
